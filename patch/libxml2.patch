-	int ret = xmlXPathCompOpEvalToBoolean(ctxt,
-	    &comp->steps[comp->last], 0);
-	ctxt->context->depth = oldDepth;
-	return(ret);
-    } else {
+    if (toBool)
+	return(xmlXPathCompOpEvalToBoolean(ctxt,
+	    &comp->steps[comp->last], 0));
